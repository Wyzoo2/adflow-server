NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=2h

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=adflow
DB_CONNECTION_LIMIT=10

REPORT_DIR=storage/reports
PDF_FONT_PATH=C:\Windows\Fonts\simhei.ttf
LOG_LEVEL=info

# 投放数据自动变化：投放中的计划按间隔滚动更新，最终落在目标的 90%-110%
AUTO_DATA_ENABLED=true
AUTO_TICK_INTERVAL_MS=60000
